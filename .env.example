# ============================================================================
# БасТур — шаблон окружения (VPS, pm2)
# Скопируйте в .env и заполните значения. Секреты не коммитить в git!
# ============================================================================

# --- Домен сайта (ГЛАВНЫЙ переключатель) -----------------------------------
# Единственный источник правды для canonical URL, sitemap, robots, OG-разметки
# и Secure-флага админ-куки (https → Secure включается автоматически).
#
# Сейчас сайт работает на временном домене. Когда переедете на боевой домен,
# поменяйте ТОЛЬКО эту строку и переделойте (./deploy.sh):
#   NEXT_PUBLIC_SITE_URL=https://bus-tour.by
NEXT_PUBLIC_SITE_URL=https://testnetnext.top

# --- Режим деплоя -----------------------------------------------------------
# production — капча и все защиты включены (обязательно для публичного сервера).
# dev        — публичный стенд: капча тоже включена; BYPASS_RECAPTCHA=1 разрешён только для CI.
# local      — машина разработчика: капча пропускается автоматически.
BASTUR_DEPLOY_ENV=production

NODE_ENV=production
PORT=3000

# --- База данных (нативный PostgreSQL на VPS) -------------------------------
# Создаётся автоматически при первом запуске: ./deploy.sh --setup
DATABASE_URL=postgresql://bastur:CHANGE_ME@127.0.0.1:5432/bastur

# 1 = не выполнять миграции при старте веб-процесса (схема управляется
# деплоем через `npm run db:migrate:prod`). Обязательно, если схему
# накатывали через `drizzle-kit push` — иначе "relation already exists".
# BASTUR_SKIP_RUNTIME_MIGRATIONS=1

# --- Безопасность ------------------------------------------------------------
# Сгенерировать: openssl rand -hex 32
AUTH_SECRET=
# Первичный админ (создаётся при инициализации пустой БД)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Сгенерировать: openssl rand -hex 32
REVIEW_CONTACT_SECRET=

# --- Google reCAPTCHA v3 ------------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Уведомления о заявках (опционально) -------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# RESEND_API_KEY=
# LEAD_EMAIL_TO=info@bus-tour.by
# LEAD_EMAIL_FROM=БасТур <noreply@bus-tour.by>

# --- Медиа-обработка ----------------------------------------------------------
# 1 = не конвертировать в webp (экономит CPU на слабом VPS)
MEDIA_SKIP_WEBP=1
# MEDIA_WORKER_POLL_MS=3000
# MEDIA_WORKER_LEASE_MS=120000
