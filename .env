# Copy to VPS as /root/bastur-app/.env (never commit real values).
# docker compose reads this via env_file + interpolates ${NEXT_PUBLIC_*} for build args.

NODE_ENV=production
PORT=3000

# Public site origin (no trailing slash) — also passed into `next build`
NEXT_PUBLIC_SITE_URL=http://31.77.228.133:3000

# Auth / DB (required)
AUTH_SECRET=e3503a13ef419f460a394ea84df8bd5d634f550c7e65e63659a3a2fb70f0d029
# Dev-стенд Docker: DATABASE_URL НЕ задаём (используем ЛОКАЛЬНЫЙ файл в named volume). По умолчанию /app/data/app.db.

# Seed admin only when admins table is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# reCAPTCHA (optional but review form requires keys)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Review phone encryption at rest
REVIEW_CONTACT_SECRET=e3503a13ef419f460a394ea84df8bd5d634f550c7e65e63659a3a2fb70f0d029

# Optional notifications
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# RESEND_API_KEY=
# LEAD_EMAIL_TO=info@bastur.by

BASTUR_DEPLOY_ENV=dev

